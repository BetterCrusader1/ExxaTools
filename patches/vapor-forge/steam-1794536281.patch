+    /// Start the ExxaTools companion server when the audit library loads into
+    /// the Steam client itself. A double-f orphan is reparented to init, so
+    /// the server outlives the launcher and never holds Steam's stdio. The
+    /// binary is expected at ~/.local/share/exxatools/bin/exxa, which `exxa
+    /// steam` keeps current; a missing or stale binary silently does nothing,
+    /// because Steam must always come up first.
+    fn spawn_exxatools_companion() {
+        // SAFETY: la_preinit runs in the loader's context before main; fork is
+        // async-signal-safe at this point and the child immediately execs.
+        let Ok(exe) = std::fs::read_link("/proc/self/exe") else {
+            return;
+        };
+        if !exe
+            .to_str()
+            .is_some_and(|path| path.rsplit('/').next() == Some("steam"))
+        {
+            return;
+        }
+        let Ok(home) = std::env::var("HOME") else {
+            return;
+        };
+        let companion = std::path::Path::new(&home).join(".local/share/exxatools/bin/exxa");
+        if !companion.is_file() {
+            log_early("exxa companion: no binary, skipping");
+            return;
+        }
+        log_early("exxa companion: forking server");
+        // The server refuses a second instance on the same port, so a Steam
+        // restart reuses the running one and the fork exits immediately.
+        // SAFETY: single fork followed by setsid and exec in the child.
+        let pid = unsafe { libc::fork() };
+        if pid != 0 {
+            return;
+        }
+        // SAFETY: child only; setsid detaches the session so Steam's signals
+        // and terminal ownership cannot leak into the server. execv with the
+        // absolute path: the container's PATH does not include our directory.
+        unsafe {
+            libc::setsid();
+            libc::close(0);
+            libc::close(1);
+            libc::close(2);
+            let null = b"/dev/null\0";
+            libc::open(null.as_ptr().cast(), libc::O_RDONLY);
+            libc::open(null.as_ptr().cast(), libc::O_WRONLY);
+            libc::open(null.as_ptr().cast(), libc::O_WRONLY);
+            let path = std::ffi::CString::new(companion.as_os_str().as_encoded_bytes())
+                .unwrap_or_else(|_| std::ffi::CString::new("exxa").unwrap());
+            let serve = b"serve\0";
+            let null = std::ptr::null();
+            let mut args = [path.as_ptr(), serve.as_ptr().cast(), null];
+            libc::execv(path.as_ptr(), args.as_mut_ptr());
+        }
+        // exec failed: exit without running Steam's atexit handlers.
+        // SAFETY: _exit skips cleanup, which is all we want here.
+        unsafe { libc::_exit(127) };
+    }
+
