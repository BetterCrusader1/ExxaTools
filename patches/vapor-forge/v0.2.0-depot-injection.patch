+#[test]
+fn plan_files_bind_manifests_to_the_declared_app() {
+    let dir = std::env::temp_dir().join(format!("lua-app-binding-{}", std::process::id()));
+    let _ = std::fs::create_dir_all(&dir);
+    std::fs::write(
+        dir.join("108600.lua"),
+        "-- @appid 108600\naddappid(108600)\nsetmanifestid(108603, \"300\", 5000)\n",
+    )
+    .unwrap();
+    std::fs::write(
+        dir.join("2605790.lua"),
+        "-- @appid 2605790\naddappid(2605790)\nsetmanifestid(2605791, \"400\", 6000)\n",
+    )
+    .unwrap();
+    let state = execute_scripts(&[dir.to_string_lossy().into_owned()]);
+    assert_eq!(state.manifests[&DepotId(108603)].app_id, Some(AppId(108600)));
+    assert_eq!(state.manifests[&DepotId(2605791)].app_id, Some(AppId(2605790)));
+    let _ = std::fs::remove_dir_all(&dir);
+}
