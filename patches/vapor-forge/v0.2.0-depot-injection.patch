+/// Add script-pinned depots that Steam omitted from its dependency vector.
+///
+/// An unowned app can reach BuildDepotDependency with an empty CUtlVector
+/// because Steam has no license-derived dependency list. The vector is backed
+/// by the process allocator, so a fresh libc allocation is safe to hand back;
+/// Steam frees the replacement at the same lifetime boundary as the original.
+/// Injection is limited to apps named in an active plan, and only to depots
+/// whose override declares this app, so one plan cannot mount another's depots.
+unsafe fn inject_missing_depots(
+    vec: *mut vapor_forge_steam_native_abi::CUtlVector<vapor_forge_steam_native_abi::DepotEntry>,
+    app_id: u32,
+    ss: &vapor_forge_core::ScriptState,
+) {
+    use std::mem::size_of;
+    use vapor_forge_steam_native_abi::DepotEntry;
+
+    let Some(vec) = (unsafe { vec.as_mut() }) else {
+        return;
+    };
+    if !ss.apps.contains(&vapor_forge_config::AppId(app_id)) {
+        return;
+    }
+    let size = vec.len();
+    let mut present = Vec::with_capacity(size);
+    for i in 0..size {
+        // SAFETY: i < len().
+        present.push(unsafe { vec.get(i) }.depot_id);
+    }
+    let missing: Vec<_> = ss
+        .manifests
+        .iter()
+        .filter(|(depot_id, override_value)| {
+            vapor_forge_features::manifest::belongs_to_app(
+                override_value,
+                vapor_forge_config::AppId(app_id),
+            ) && !present.contains(&depot_id.0)
+        })
+        .map(|(depot_id, ov)| (*depot_id, ov.clone()))
+        .collect();
+    if missing.is_empty() {
+        return;
+    }
+
+    let new_size = size + missing.len();
+    let capacity = new_size.max(vec.capacity());
+    let old_ptr = vec.m_memory.m_p_memory;
+    let old_capacity = vec.m_memory.m_n_allocation_count as usize;
+    let new_ptr = if capacity <= old_capacity && !old_ptr.is_null() {
+        old_ptr
+    } else {
+        // SAFETY: calloc returns either null or a writable zeroed block of the
+        // requested size; Steam frees it with the same process allocator.
+        let ptr = unsafe { libc::calloc(capacity, size_of::<DepotEntry>()) }.cast::<DepotEntry>();
+        if ptr.is_null() {
+            return;
+        }
+        if size > 0 && !old_ptr.is_null() {
+            // SAFETY: the old vector's allocation covers size entries.
+            unsafe { std::ptr::copy_nonoverlapping(old_ptr, ptr, size) };
+        }
+        vec.m_memory.m_p_memory = ptr;
+        vec.m_memory.m_n_allocation_count = capacity as u32;
+        vec.m_memory.m_n_grow_size = capacity as u32;
+        ptr
+    };
+
+    let mut index = size;
+    for (depot_id, ov) in missing {
+        let entry = DepotEntry {
+            depot_id: depot_id.0,
+            app_id,
+            manifest_gid: ov.gid.0,
+            manifest_size: ov.size.unwrap_or(0),
+            dlc_app_id: 0,
+            lcs_required: 0,
+            b_not_new_target: 0,
+            shared_install: 0,
+            _padding: 0,
+        };
+        // SAFETY: index < capacity and new_ptr points to capacity entries.
+        unsafe { *new_ptr.add(index) = entry };
+        index += 1;
+        info!(
+            depot_id = depot_id.0,
+            manifest_gid = ov.gid.0,
+            manifest_size = ov.size.unwrap_or(0),
+            "manifest: injected"
+        );
+    }
+    vec.m_size = new_size as i32;
+}
